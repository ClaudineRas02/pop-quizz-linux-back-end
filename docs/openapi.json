          }
        ],
        "responses": {
          "200": {
            "description": "Question trouvee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuestionDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/questions/create": {
      "post": {
        "tags": ["Questions"],
        "summary": "Creer une question",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Question creee",
            "content": {
              "application/json": {
