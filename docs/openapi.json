                }
              }
            }
          }
        }
      }
    },
    "/api/admin/questions/delete/{questionId}": {
      "delete": {
        "tags": ["Questions"],
        "summary": "Supprimer une question",
        "parameters": [
          {
            "$ref": "#/components/parameters/QuestionId"
          }
        ],
        "responses": {
          "204": {
            "description": "Question supprimee"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "AdminId": {
        "name": "adminId",
        "in": "path",
        "required": true,
        "description": "Identifiant de l'administrateur",
        "schema": {
          "type": "integer"
        }
      },
      "PlayerId": {
        "name": "playerId",
        "in": "path",
        "required": true,
        "description": "Identifiant du joueur",
        "schema": {
          "type": "integer"
        }
      },
      "GameId": {
        "name": "gameId",
        "in": "path",
        "required": true,
        "description": "Identifiant de la partie",
        "schema": {
          "type": "integer"
        }
      },
      "QuestionId": {
        "name": "questionId",
        "in": "path",
        "required": true,
        "description": "Identifiant de la question",
        "schema": {
          "type": "integer"
        }
      },
      "PlayerIdQuery": {
        "name": "playerId",
        "in": "query",
        "required": true,
        "description": "Identifiant du joueur",
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "success": { "type": "boolean" }
            }
          }
        }
      },
      "Admin": {
        "type": "object",
        "properties": {
          "adminId": { "type": "integer" },
          "email": { "type": "string" },
          "createdAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "AdminAuthRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "AdminResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Admin"
          }
        }
      },
      "AdminListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Admin"
            }
          }
        }
      },
      "AdminAuthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "admin": {
                "$ref": "#/components/schemas/Admin"
              }
            }
          }
        }
      },
      "AdminLoginResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "admin": {
                "$ref": "#/components/schemas/Admin"
              },
              "token": { "type": "string" }
            }
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "playerId": { "type": "integer" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"] },
          "createdAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "PlayerRegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string" },
          "password": { "type": "string" },
          "avatarUrl": { "type": ["string", "null"] }
        }
      },
      "PlayerLoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "PlayerAvatarUpdateRequest": {
        "type": "object",
        "required": ["avatarUrl"],
        "properties": {
          "avatarUrl": { "type": "string" }
        }
      },
      "PlayerResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Player"
          }
        }
      },
      "PlayerListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          }
        }
      },
      "PlayerAuthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "player": {
                "$ref": "#/components/schemas/Player"
              }
            }
          }
        }
      },
      "PlayerLoginResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "player": {
                "$ref": "#/components/schemas/Player"
              },
              "token": { "type": "string" }
            }
          }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "gameId": { "type": "integer" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["waiting", "running", "finished"]
          },
          "createdBy": { "type": ["integer", "null"] },
          "totalQuestions": { "type": "integer" },
          "startTime": { "type": ["string", "null"], "format": "date-time" },
          "endTime": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": ["string", "null"], "format": "date-time" }
        }
      },
      "GameCreateRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["waiting", "running", "finished"],
            "default": "waiting"
          },
          "totalQuestions": { "type": "integer", "minimum": 0 },
          "createdBy": { "type": ["integer", "null"] }
        }
      },
      "GameUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "status": {
